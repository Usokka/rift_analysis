# Local development only. Copy to .env before starting.
POSTGRES_DB=rift_analyst
POSTGRES_USER=rift
POSTGRES_PASSWORD=rift_local_only
API_PORT=8000
WEB_PORT=3000
# Used when running the API outside Compose:
DATABASE_URL=postgresql+psycopg://rift:rift_local_only@localhost:5432/rift_analyst
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
